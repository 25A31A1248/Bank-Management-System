#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Account {
    int acc_no;
    char name[50];
    float balance;
};

// Create Account
void createAccount() {
    FILE *fp = fopen("bank.txt", "a");
    struct Account a;

    printf("Enter Account Number: ");
    scanf("%d", &a.acc_no);

    printf("Enter Name: ");
    scanf("%s", a.name);

    printf("Enter Initial Balance: ");
    scanf("%f", &a.balance);

    fwrite(&a, sizeof(a), 1, fp);
    fclose(fp);

    printf("Account Created Successfully!\n");
}

